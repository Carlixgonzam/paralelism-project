# A local stand-in for a player VM's sshd, reached only over the compose
# network. StrictModes is off because the authorized_keys file arrives via a
# bind mount, whose host-side permissions sshd would otherwise reject.
Port 22
PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
StrictModes no
UsePAM no
Subsystem sftp /usr/lib/openssh/sftp-server
