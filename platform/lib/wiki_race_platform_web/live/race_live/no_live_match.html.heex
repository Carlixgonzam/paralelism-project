<div class="py-16 text-center">
  <p class="text-stroke-comic-sm font-display text-5xl tracking-wide text-comic-yellow [text-shadow:4px_4px_0_#000] sm:text-6xl">
    {idle_title(@progress)}
  </p>
  <p class="mt-4 font-heading text-comic-ink/60">
    <.link navigate={~p"/schedule"} class="font-bold text-comic-red underline">
      check the schedule tab
    </.link>
    for {idle_hint(@progress)}.
  </p>
</div>
