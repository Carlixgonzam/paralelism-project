<div>
  <div class="flex flex-wrap items-center justify-center gap-10">
    <div
      :if={@snapshot.config}
      class="flex h-38 w-38 -rotate-6 flex-col items-center justify-center rounded-full border-[3px] border-black bg-comic-yellow p-3 text-center shadow-comic-pop"
    >
      <div class="font-comic-mono text-sm font-bold tracking-wide">START</div>
      <div class="mt-1 line-clamp-2 font-heading text-xl leading-tight font-extrabold">
        {title_of(@snapshot.config.start_url)}
      </div>
    </div>

    <div
      class="flex h-49 w-49 items-center justify-center rounded-full border-[3px] border-black p-2"
      style={timer_ring_style(@elapsed, @snapshot.config)}
    >
      <div class="flex h-full w-full flex-col items-center justify-center rounded-full bg-comic-paper-light">
        <div class="font-display text-7xl tracking-wide">{format_ms_clock(@elapsed)}</div>
        <div class="font-comic-mono text-xs font-bold tracking-wide text-comic-ink/60">
          ELAPSED
        </div>
      </div>
    </div>

    <div
      :if={@snapshot.config}
      class="flex h-38 w-38 rotate-6 flex-col items-center justify-center rounded-full border-[3px] border-black bg-comic-emerald p-3 text-center text-comic-paper-light shadow-comic-pop"
    >
      <div class="font-comic-mono text-sm font-bold tracking-wide">TARGET</div>
      <div class="mt-1 line-clamp-2 font-heading text-xl leading-tight font-extrabold">
        {title_of(@snapshot.config.target_url)}
      </div>
    </div>
  </div>

  <div class="mt-5 flex justify-center">
    <div class="flex items-center gap-2 rounded-full border-[3px] border-black bg-comic-red px-5 py-1.5 text-comic-paper-light shadow-comic-pop">
      <span class={[
        "h-2.5 w-2.5 rounded-full bg-comic-paper-light",
        @snapshot.status == :running && "animate-pulse-dot"
      ]} />
      <span class="font-heading text-sm font-extrabold tracking-wide">
        {round_label(@progress)}
      </span>
    </div>
  </div>
</div>
