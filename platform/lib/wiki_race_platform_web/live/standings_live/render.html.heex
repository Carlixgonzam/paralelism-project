<Layouts.app flash={@flash} active_page={:standings}>
  <.header stamp="blue">
    Standings
  </.header>

  <p :if={map_size(@standings) == 0} class="py-16 text-center text-comic-ink/60">
    No groups configured yet.
  </p>

  <ol :if={map_size(@standings) > 0} class="mt-2">
    <li
      :for={{{name, standing}, index} <- Enum.with_index(sorted_standings(@standings), 1)}
      class="flex flex-wrap items-center gap-4 border-b-2 border-dashed border-black py-4"
    >
      <span class={[
        "w-12 font-display text-4xl",
        index == 1 && standing.games > 0 && "text-stroke-comic-sm text-comic-red"
      ]}>
        {index}
      </span>
      <span class="min-w-[12ch] flex-1 font-display text-2xl tracking-wide">{name}</span>

      <span
        :if={standing.games == 0}
        class="font-comic-mono text-base text-comic-ink/40 italic"
      >
        no data yet
      </span>

      <div
        :if={standing.games > 0}
        class="h-3 w-48 border-2 border-black bg-comic-paper-dim"
      >
        <div
          class={["h-full", if(index == 1, do: "bg-comic-red", else: "bg-black")]}
          style={"width: #{score_bar_pct(standing, @standings)}%"}
        />
      </div>
      <span
        :if={standing.games > 0}
        class="w-24 text-right font-comic-mono text-base font-bold text-comic-ink tabular-nums"
      >
        score {:erlang.float_to_binary(standing.score_sum, decimals: 2)}
      </span>
    </li>
  </ol>

  <div class="mt-10 border-t-[3px] border-black pt-6">
    <p class="font-comic-mono text-xs tracking-widest text-comic-ink/50 uppercase">
      How the score is calculated
    </p>

    <div class="mt-3 flex flex-wrap items-center gap-2 font-comic-mono text-xs font-bold tracking-wide uppercase sm:text-sm">
      <span class="rounded border-2 border-black bg-comic-paper-dim px-2.5 py-1">Score</span>
      <span class="text-comic-ink/40">=</span>
      <%= for {term, index} <- Enum.with_index(score_terms()) do %>
        <span class={[
          "rounded border-2 border-black px-2.5 py-1 text-comic-paper-light",
          term.color
        ]}>
          {term.pct}% {term.label}
        </span>
        <span :if={index < length(score_terms()) - 1} class="text-comic-ink/40">+</span>
      <% end %>
    </div>

    <div class="mt-4 flex h-5 w-full overflow-hidden border-2 border-black">
      <div
        :for={term <- score_terms()}
        class={term.color}
        style={"width: #{term.pct}%"}
        title={"#{term.label}: #{term.pct}%"}
      />
    </div>

    <ul class="mt-4 space-y-2">
      <li
        :for={term <- score_terms()}
        class="flex items-start gap-3 border-b-2 border-dashed border-black pb-2 font-comic-mono text-xs text-comic-ink/70 sm:text-sm"
      >
        <span class={[
          "mt-0.5 h-3 w-3 shrink-0 rounded-full border-2 border-black",
          term.color
        ]} />
        <span>
          <span class="font-bold text-comic-ink">{term.label} ({term.pct}%):</span>
          {term.desc}
        </span>
      </li>
    </ul>

    <div class="mt-4 flex items-start gap-3 border-2 border-black bg-comic-red px-4 py-3 text-comic-paper-light">
      <span class="font-display text-2xl leading-none">!</span>
      <p class="font-comic-mono text-xs font-bold tracking-wide uppercase sm:text-sm">
        Reporting a path that fails verification scores &minus;1.0 flat, no matter
        the other metrics.
      </p>
    </div>
  </div>
</Layouts.app>
