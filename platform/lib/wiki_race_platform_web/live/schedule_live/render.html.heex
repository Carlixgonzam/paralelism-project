<Layouts.app flash={@flash} active_page={:schedule}>
  <.header stamp="red">
    Race day card
    <:subtitle>{tagline(@progress)}</:subtitle>
    <:note>
      Every match decided so far, the live one, and this round's queue.
      Future rounds are not paired yet. Swiss decides each round from the
      one before it, so there is nothing further to show until this round
      finishes.
    </:note>
  </.header>

  <p :if={@pair} class="text-center font-comic-mono text-xs text-comic-ink/50">
    every match: {@pair.start} &rarr; {@pair.target}
  </p>

  <p :if={@rows == []} class="py-16 text-center text-comic-ink/60">
    No matches yet.
  </p>

  <ol :if={@rows != []} class="mt-4">
    <li
      :for={row <- @rows}
      class="flex flex-wrap items-center gap-3 border-b-2 border-dashed border-black py-3"
    >
      <span class="min-w-[20ch] flex-1 font-display text-xl tracking-wide">{row.label}</span>
      <span class={[
        "rounded-full border-2 border-black px-3 py-1 font-comic-mono text-xs font-bold tracking-wide uppercase",
        row_badge_class(row.status)
      ]}>
        {row.detail}
      </span>
    </li>
  </ol>
</Layouts.app>
