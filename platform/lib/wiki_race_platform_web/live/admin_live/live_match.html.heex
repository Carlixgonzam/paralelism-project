<div class="mx-auto max-w-lg text-center">
  <p class="font-display text-2xl tracking-wide">
    {@snapshot.players |> Enum.map(& &1.label) |> Enum.join(" vs ")}
    <span class="font-heading text-sm text-comic-ink/50">live</span>
  </p>

  <button
    type="button"
    phx-click="abort"
    class="mt-6 w-full border-[3px] border-comic-red bg-comic-paper-light px-6 py-3
           font-heading font-extrabold text-comic-red shadow-comic-pop"
  >
    ■ Abort race
  </button>
</div>
