<div class="mx-auto mt-10 max-w-lg border-t-2 border-dashed border-black pt-6 text-center">
  <p class="font-comic-mono text-[10px] font-bold tracking-wider text-comic-ink/50 uppercase">
    Danger zone
  </p>
  <button
    type="button"
    phx-click="restart_tournament"
    data-confirm="Restart the tournament? This clears every recorded race result. There is no undo."
    class="mt-2 border-[3px] border-comic-red bg-comic-paper-light px-4 py-2 font-heading
           text-sm font-extrabold text-comic-red shadow-comic-pop"
  >
    ⟲ Restart tournament
  </button>
</div>
